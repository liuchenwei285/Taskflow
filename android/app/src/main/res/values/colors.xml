<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Taskflow 调色板 · 浅色（纯白底 · 微冷灰 + 靛蓝强调）
         全站唯一强调色相：primary（静态靛蓝 / API31+ 壁纸取色）。
         禁止黄绿、棕、黄、橙；分层靠 1dp outline + surfaceVariant 填充。
         ============================================================ -->
    <color name="tf_bg">#FFFFFF</color>
    <color name="tf_surface">#FFFFFF</color>
    <color name="tf_surface_variant">#F1F3F7</color>
    <color name="tf_on_bg">#1A1C1F</color>
    <color name="tf_on_surface_variant">#5B6068</color>
    <color name="tf_outline">#E1E4EA</color>
    <color name="tf_outline_strong">#7A808A</color>

    <!-- 静态回退强调色（仅本文件与 values-night 允许出现具体色值） -->
    <color name="tf_accent">#355C9A</color>
    <color name="tf_on_accent">#FFFFFF</color>
    <color name="tf_accent_strong">#355C9A</color>
    <color name="tf_primary_container">#D9E3F8</color>
    <color name="tf_on_primary_container">#0B1B3A</color>
    <color name="tf_accent_soft">#1F355C9A</color>

    <color name="tf_error">#B3261E</color>
    <color name="tf_error_container">#FCE4E1</color>
    <color name="tf_on_error_container">#410E0B</color>

    <color name="tf_scrim">#991A1C1F</color>

    <!-- 兼容既有主题引用 -->
    <color name="md_surface">@color/tf_bg</color>
    <color name="md_primary">@color/tf_accent</color>
    <color name="md_on_primary">@color/tf_on_accent</color>
</resources>
