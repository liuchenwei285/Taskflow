<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色主题：状态栏/导航栏用浅色图标，避免首帧黑底黑字 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tf_bg</item>
        <item name="android:statusBarColor">@color/tf_bg</item>
        <item name="android:navigationBarColor">@color/tf_bg</item>
        <item name="android:colorPrimary">@color/tf_accent</item>
        <item name="android:colorAccent">@color/tf_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
