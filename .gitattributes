# 默认按文本处理，仓库内统一 LF，避免 Windows 上把 shell 脚本写成 CRLF
* text=auto eol=lf

# 脚本与源码：强制 LF（CRLF 的 .sh 在 Linux/macOS 上会直接执行失败）
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# 二进制
*.png binary
*.webm binary
*.apk binary
*.jks binary
