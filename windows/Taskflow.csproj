<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Taskflow</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>taskflow.ico</ApplicationIcon>
    <Version>2.6.1</Version>
    <Product>Taskflow</Product>
    <Company>Taskflow</Company>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app\taskflow.html" LogicalName="Taskflow.taskflow.html" />
    <EmbeddedResource Include="taskflow.ico" LogicalName="Taskflow.taskflow.ico" />
  </ItemGroup>

</Project>
